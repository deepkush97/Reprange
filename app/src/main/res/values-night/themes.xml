<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark variant follows the SYSTEM setting (matches DarkMode.AUTO default).
         Forced ON/OFF from in-app prefs is handled by the Compose root background. -->
    <style name="Theme.Reprange" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Reprange.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#14161C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Reprange</item>
    </style>
</resources>
